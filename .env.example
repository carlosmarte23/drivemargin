# Supabase project URL.
# Used by Supabase clients for Auth and API access.
# Find it in Supabase Dashboard -> Project Settings -> API,
# or from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key.
# Safe to expose in the browser when Row Level Security policies are enabled.
# Find it in Supabase Dashboard -> Project Settings -> API Keys.
# Prefer the new sb_publishable_* key. If your project only shows a legacy anon key,
# use the anon key here temporarily.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL connection string for Drizzle ORM and migrations.
# Keep this server-only. Do not prefix with NEXT_PUBLIC_.
# Find it in Supabase Dashboard -> Connect -> Transaction pooler.
# Recommended for Vercel/serverless deployments. Replace [YOUR-PASSWORD]
# with your database password.
DATABASE_URL=
